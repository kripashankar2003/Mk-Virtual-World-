rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Public profile directory — any signed-in user can read so the feed can
    // render the uploader's username and profile picture on every post.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Notes are public content (shown in the shared feed), editable by owner.
      match /notes/{noteId} {
        allow read: if signedIn();
        allow create: if isOwner(userId);
        allow update, delete: if isOwner(userId);

        // Likes and comments on a note — readable by all, writable by any signed-in user.
        match /likes/{likeId} {
          allow read: if signedIn();
          allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
          allow delete: if signedIn() && request.auth.uid == likeId;
        }
        match /comments/{commentId} {
          allow read: if signedIn();
          allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
          allow update, delete: if signedIn() && request.auth.data.userId == request.auth.uid;
        }
      }

      // Photos and videos — public once published, owned by the uploader.
      match /media/{mediaId} {
        allow read: if signedIn() && (resource.data.published == true || isOwner(userId));
        allow create: if isOwner(userId)
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.published == true;
        allow update, delete: if isOwner(userId)
          && resource.data.ownerId == request.auth.uid;

        match /likes/{likeId} {
          allow read: if signedIn();
          allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
          allow delete: if signedIn() && request.auth.uid == likeId;
        }
        match /comments/{commentId} {
          allow read: if signedIn();
          allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
          allow update, delete: if signedIn() && request.resource.data.userId == request.auth.uid;
        }
      }
    }

    // Chat threads — private to their participants.
    match /chats/{chatId} {
      allow read, update: if signedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if signedIn()
          && request.auth.uid == resource.data.senderId;
      }
    }
  }
}
